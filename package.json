{
  "name": "triply",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "bun run --cwd packages/shared build && playwright test",
    "test:e2e:headed": "bun run test:e2e --headed",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "bun run --cwd apps/api typecheck:e2e",
    "validate:translations": "bun run --cwd apps/web validate:translations",
    "audit:translations": "bun run --cwd apps/web audit:translations"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "turbo": "^2.11.6"
  }
}
