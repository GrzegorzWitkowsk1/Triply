PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/triply
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
AI_PROVIDER=gemini
# AI_MODEL is the model for the selected provider.
# Gemini defaults to gemini-flash-latest; openrouter requires an explicit model.
# AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=45000
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Routing: the routed-foot endpoint serves actual walking routes.
# The URL profile is "driving" even though the endpoint's graph is pedestrian.
# For a custom server, use the modes its graph supports and its URL profile.
ROUTING_PROVIDER=osrm
ROUTING_OSRM_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_OSRM_PROFILE=driving
ROUTING_ENABLED_MODES=walking
ROUTING_MODE=walking
ROUTING_TIMEOUT_MS=8000
ROUTING_RETURN_TO_START=false
