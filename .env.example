PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/triply
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
AI_PROVIDER=gemini
# AI_MODEL is the model for the selected provider.
# Gemini defaults to gemini-flash-latest; openrouter requires an explicit model.
# AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=45000
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Routing: OSRM base URL and the travel profiles the configured server actually serves.
# The public demo (https://router.project-osrm.org) only serves "driving".
# For walking routes, point ROUTING_OSRM_URL at a foot-profile OSRM and set ROUTING_ENABLED_MODES=walking.
ROUTING_PROVIDER=osrm
ROUTING_OSRM_URL=https://router.project-osrm.org
ROUTING_ENABLED_MODES=driving
ROUTING_MODE=walking
ROUTING_TIMEOUT_MS=8000
ROUTING_RETURN_TO_START=false
