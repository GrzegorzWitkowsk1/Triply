{
  "name": "@triply/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run validate:translations && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun run validate:translations && vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "validate:translations": "bun scripts/validateTranslations.ts",
    "audit:translations": "bun scripts/auditTranslations.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.103.2",
    "@triply/shared": "workspace:*",
    "i18next": "^26.5.5",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.1.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^5.0.3"
  }
}
